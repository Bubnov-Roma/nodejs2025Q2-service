            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Test123!@#\",\n  \"newPassword\": \"NewPass456!@#\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/user/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "{{testUserId}}"]
            }
          }
        },
        {
