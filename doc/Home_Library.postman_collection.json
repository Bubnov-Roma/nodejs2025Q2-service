                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/{{testUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["user", "{{testUserId}}"]
            }
          }
        }
