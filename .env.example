NODE_ENV=development
PORT=4000

CRYPT_SALT=10
JWT_SECRET_KEY=secret123123
JWT_SECRET_REFRESH_KEY=secret123123
TOKEN_EXPIRE_TIME=1h
TOKEN_REFRESH_EXPIRE_TIME=24h

# PostgreSQL Configuration
POSTGRES_HOST=postgres  # For DOCKER (postgres in container)
# or
POSTGRES_HOST=localhost # For LOCAL (postgres on localhost)

POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=home_library

# Prisma Database

# For LOCAL development (postgres on localhost)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/home_library?schema=public"
# or

# For DOCKER (postgres in container)
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/home_library?schema=public"

# Logging Configuration
# 0 - no logs
# 1 - error only
# 2 - error, warn
# 3 - error, warn, log (default)
# 4 - error, warn, log, debug
# 5 - all (error, warn, log, debug, verbose)
LOG_LEVEL=3
MAX_LOG_FILE_SIZE=5120

# Docker Hub
DOCKER_USERNAME=your_username

# Clear logs on startup (DOCKER/LOCAL) (false/true)
CLEAR_LOGS_ON_STARTUP=false